<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.OmniDeck" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="OmniCard">
        <item name="android:background">@drawable/card_selector</item>
        <item name="android:padding">14dp</item>
        <item name="android:focusable">false</item>
        <item name="android:clickable">false</item>
    </style>

    <style name="OmniPillButton">
        <item name="android:background">@drawable/pill_selector</item>
        <item name="android:textColor">@drawable/pill_text_selector</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
</resources>
