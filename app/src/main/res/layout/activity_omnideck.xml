<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#06080C"
    android:padding="16dp">

    <!-- Top Navigation & Status Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="#F0F4FA"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tv_creator_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Crafted by Mahan Vyakti"
                    android:textColor="#00A8FF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/pill_selector"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:focusable="false" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Living Room System Diagnostics &amp; Companion Vault"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:fontFamily="sans-serif"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <!-- Google Docs Style Collaborative Avatars Container -->
        <LinearLayout
            android:id="@+id/ll_top_avatars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginEnd="8dp" />

        <!-- Active Devices Badge (Clickable with D-pad) -->
        <TextView
            android:id="@+id/tv_connected_devices_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 Devices Active"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/header_device_badge_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:focusable="true"
            android:clickable="true"
            android:nextFocusDown="@+id/btn_purge_ram"
            android:nextFocusRight="@+id/tv_device_info"
            android:layout_marginEnd="10dp" />

        <TextView
            android:id="@+id/tv_device_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="192.168.1.100:8080"
            android:textColor="#00A8FF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/pill_selector"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:focusable="false" />
    </LinearLayout>

    <!-- Real-time Companion Live Action Banner (Requirement 7) -->
    <LinearLayout
        android:id="@+id/ll_live_action_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/pill_selector"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_live_action_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡"
            android:textSize="13sp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tv_live_action_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Companion action triggered"
            android:textColor="#00E5FF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tv_live_action_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LIVE ACTION"
            android:textColor="#94A3B8"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />
    </LinearLayout>

    <!-- Main Bento Grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Column 1: System Memory & Bandwidth (Weight 1.05) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.05"
            android:orientation="vertical"
            android:layout_marginEnd="10dp">

            <!-- Card 1: System Memory -->
            <LinearLayout
                android:id="@+id/card_ram"
                style="@style/OmniCard"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="System Memory"
                            android:textColor="#94A3B8"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Heap memory &amp; background tasks"
                            android:textColor="#475569"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btn_purge_ram"
                        style="@style/OmniPillButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="Purge RAM"
                        android:textSize="11sp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:nextFocusUp="@+id/tv_connected_devices_badge"
                        android:nextFocusDown="@+id/btn_speed_test"
                        android:nextFocusRight="@+id/btn_copy_clipboard" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_ram_main"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- MB (0%)"
                    android:textColor="#F8FAFC"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif"
                    android:layout_marginTop="2dp" />

                <com.mahanapps.omnideck.android.GraphHistoryView
                    android:id="@+id/graph_ram"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Card 2: Network Bandwidth & Latency -->
            <LinearLayout
                android:id="@+id/card_network"
                style="@style/OmniCard"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Network Bandwidth"
                            android:textColor="#94A3B8"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Throughput &amp; Cloudflare CDN check"
                            android:textColor="#475569"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btn_speed_test"
                        style="@style/OmniPillButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="Test Speed"
                        android:textSize="11sp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:nextFocusUp="@+id/btn_purge_ram"
                        android:nextFocusDown="@+id/btn_speed_test"
                        android:nextFocusRight="@+id/btn_copy_clipboard" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_speed_readout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Checking Speed..."
                    android:textColor="#00E676"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/tv_speed_subtext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Latency: -- ms • Jitter: -- ms"
                    android:textColor="#64748B"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif" />

                <com.mahanapps.omnideck.android.GraphHistoryView
                    android:id="@+id/graph_network"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Column 2: Storage & Shared Clipboard (Weight 1.0) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="10dp">

            <!-- Card 3: Storage Breakdown -->
            <LinearLayout
                android:id="@+id/card_storage"
                style="@style/OmniCard"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.9"
                android:orientation="vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Storage Allocation"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <com.mahanapps.omnideck.android.DonutChartView
                        android:id="@+id/donut_storage"
                        android:layout_width="78dp"
                        android:layout_height="78dp"
                        android:layout_marginEnd="14dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_st_free"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Free: -- GB"
                            android:textColor="#00E676"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_st_apps"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Apps &amp; Data: -- MB"
                            android:textColor="#00A8FF"
                            android:textSize="10.5sp" />

                        <TextView
                            android:id="@+id/tv_st_media"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Media: -- MB"
                            android:textColor="#FFB300"
                            android:textSize="10.5sp" />

                        <TextView
                            android:id="@+id/tv_st_downloads"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Downloads: -- MB"
                            android:textColor="#00E5FF"
                            android:textSize="10.5sp" />

                        <TextView
                            android:id="@+id/tv_st_sys"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="System: -- GB"
                            android:textColor="#8B95A5"
                            android:textSize="10.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hard 500 MB floor protected."
                    android:textColor="#475569"
                    android:textSize="10sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Card 4: Shared Clipboard & Confined Vertical History (Requirement 3) -->
            <LinearLayout
                android:id="@+id/card_notes"
                style="@style/OmniCard"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Shared Clipboard"
                            android:textColor="#94A3B8"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/tv_clip_sender"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Auto-synced to TV clipboard"
                            android:textColor="#00A8FF"
                            android:textSize="10sp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btn_copy_clipboard"
                        style="@style/OmniPillButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="Copy"
                        android:textSize="11sp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:nextFocusLeft="@+id/btn_purge_ram"
                        android:nextFocusRight="@+id/btn_clear_clipboard"
                        android:nextFocusDown="@+id/sv_clip_history" />

                    <Button
                        android:id="@+id/btn_clear_clipboard"
                        style="@style/OmniPillButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="Clear"
                        android:textSize="11sp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:layout_marginStart="6dp"
                        android:nextFocusLeft="@+id/btn_copy_clipboard"
                        android:nextFocusRight="@+id/btn_toggle_pin"
                        android:nextFocusDown="@+id/sv_clip_history" />
                </LinearLayout>

                <!-- Active Note Preview -->
                <TextView
                    android:id="@+id/tv_note_preview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No shared notes yet. Send text or links from phone companion."
                    android:textColor="#F8FAFC"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:background="#0F1420"
                    android:padding="6dp"
                    android:layout_marginTop="4dp" />

                <!-- Confined Vertical History Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CLIPBOARD HISTORY"
                    android:textColor="#64748B"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginTop="4dp" />

                <!-- Confined ScrollView for Vertical History Items -->
                <ScrollView
                    android:id="@+id/sv_clip_history"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:scrollbars="vertical"
                    android:fadeScrollbars="false"
                    android:layout_marginTop="2dp"
                    android:focusable="false">

                    <LinearLayout
                        android:id="@+id/ll_clip_history"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tip: Click any item above to copy to TV system clipboard."
                    android:textColor="#475569"
                    android:textSize="9sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Column 3: Pairing & System Controls (Fixed 260dp) -->
        <LinearLayout
            android:layout_width="260dp"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Card 5: Scan to Connect (QR & PIN) -->
            <LinearLayout
                style="@style/OmniCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="10dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Connect Companion"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="4dp" />

                <ImageView
                    android:id="@+id/iv_qr_code"
                    android:layout_width="105dp"
                    android:layout_height="105dp"
                    android:background="#FFFFFF"
                    android:padding="4dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="QR Code to connect phone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="5dp">

                    <TextView
                        android:id="@+id/tv_pin_display"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="••••••"
                        android:textColor="#00A8FF"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.12" />

                    <Button
                        android:id="@+id/btn_toggle_pin"
                        style="@style/OmniPillButton"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:text="Show"
                        android:textSize="10sp"
                        android:paddingStart="9dp"
                        android:paddingEnd="9dp"
                        android:layout_marginStart="8dp"
                        android:nextFocusLeft="@+id/btn_copy_clipboard"
                        android:nextFocusRight="@+id/btn_new_pin"
                        android:nextFocusUp="@+id/tv_connected_devices_badge"
                        android:nextFocusDown="@+id/btn_anim_snappy" />

                    <Button
                        android:id="@+id/btn_new_pin"
                        style="@style/OmniPillButton"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:text="New"
                        android:textSize="10sp"
                        android:paddingStart="9dp"
                        android:paddingEnd="9dp"
                        android:layout_marginStart="6dp"
                        android:nextFocusLeft="@+id/btn_toggle_pin"
                        android:nextFocusUp="@+id/tv_connected_devices_badge"
                        android:nextFocusDown="@+id/btn_anim_snappy" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_pin_expiry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PIN valid for 5:00"
                    android:textColor="#64748B"
                    android:textSize="10sp"
                    android:layout_marginTop="1dp" />

                <TextView
                    android:id="@+id/tv_qr_url"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="http://192.168.1.100:8080"
                    android:textColor="#475569"
                    android:textSize="10sp"
                    android:layout_marginTop="3dp" />
            </LinearLayout>

            <!-- Card 6: System Controls & Vault Settings (Repurposed from Active Devices Card) -->
            <LinearLayout
                android:id="@+id/card_system_controls"
                style="@style/OmniCard"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="System Controls &amp; Vault"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ANIMATION SCALE"
                    android:textColor="#64748B"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginTop="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="3dp">

                    <Button
                        android:id="@+id/btn_anim_off"
                        style="@style/OmniPillButton"
                        android:layout_width="0dp"
                        android:layout_height="28dp"
                        android:layout_weight="1"
                        android:text="0.0x Off"
                        android:textSize="10sp"
                        android:layout_marginEnd="4dp"
                        android:nextFocusLeft="@+id/btn_copy_clipboard"
                        android:nextFocusRight="@+id/btn_anim_snappy"
                        android:nextFocusUp="@+id/btn_new_pin"
                        android:nextFocusDown="@+id/btn_vault_folder" />

                    <Button
                        android:id="@+id/btn_anim_snappy"
                        style="@style/OmniPillButton"
                        android:layout_width="0dp"
                        android:layout_height="28dp"
                        android:layout_weight="1.1"
                        android:text="0.5x Snappy"
                        android:textSize="10sp"
                        android:layout_marginEnd="4dp"
                        android:nextFocusLeft="@+id/btn_anim_off"
                        android:nextFocusRight="@+id/btn_anim_normal"
                        android:nextFocusUp="@+id/btn_new_pin"
                        android:nextFocusDown="@+id/btn_vault_folder" />

                    <Button
                        android:id="@+id/btn_anim_normal"
                        style="@style/OmniPillButton"
                        android:layout_width="0dp"
                        android:layout_height="28dp"
                        android:layout_weight="1"
                        android:text="1.0x Def"
                        android:textSize="10sp"
                        android:nextFocusLeft="@+id/btn_anim_snappy"
                        android:nextFocusUp="@+id/btn_new_pin"
                        android:nextFocusDown="@+id/btn_vault_folder" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STORAGE VAULT DESTINATION"
                    android:textColor="#64748B"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginTop="8dp" />

                <Button
                    android:id="@+id/btn_vault_folder"
                    style="@style/OmniPillButton"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:text="📁 /sdcard/Download"
                    android:textSize="10sp"
                    android:layout_marginTop="3dp"
                    android:nextFocusUp="@+id/btn_anim_snappy"
                    android:nextFocusDown="@+id/btn_exit_app"
                    android:nextFocusLeft="@+id/btn_copy_clipboard" />

                <TextView
                    android:id="@+id/tv_vault_tip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Press OK to toggle folder.\nIndexed by MediaStore for File Explorer."
                    android:textColor="#475569"
                    android:textSize="9sp"
                    android:layout_marginTop="3dp" />

                <Button
                    android:id="@+id/btn_exit_app"
                    style="@style/OmniPillButton"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:text="✕ Exit OmniDeck"
                    android:textColor="#F87171"
                    android:textSize="10sp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/danger_pill_selector"
                    android:nextFocusUp="@+id/btn_vault_folder"
                    android:nextFocusLeft="@+id/btn_clear_clipboard" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
